[Unit]
Description=Archipelago local GPU research queue worker
After=network-online.target graphical-session.target
Wants=network-online.target
BindsTo=graphical-session.target

[Service]
Type=simple
WorkingDirectory=/home/pratay-karali/Desktop/archipelago/Archipelago
ExecStart=/home/pratay-karali/Desktop/archipelago/Archipelago/.venv/bin/python -m archipelago.scholarly.bridge.cli
Restart=always
RestartSec=20
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
