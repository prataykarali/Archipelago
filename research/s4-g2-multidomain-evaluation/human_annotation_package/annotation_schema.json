{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Archipelago Multi-Domain Human Annotation Schema",
  "type": "object",
  "required": [
    "item_id",
    "domain",
    "concept_a",
    "concept_b",
    "human_concept_validity_a",
    "human_concept_validity_b",
    "human_relation_type",
    "human_prereq_direction",
    "human_evidence_support_0_1_2",
    "human_source_verified_0_1",
    "human_confidence_high_med_low",
    "human_uncertainty_flag"
  ],
  "properties": {
    "item_id": {
      "type": "string",
      "pattern": "^(OS|DBMS|NET|TOC|STAT|AI)-[0-9]{2}$"
    },
    "domain": {
      "type": "string",
      "enum": [
        "Operating Systems",
        "Database Management Systems",
        "Computer Networks",
        "Automata Theory & Computation",
        "Probability & Statistics",
        "Artificial Intelligence & Machine Learning"
      ]
    },
    "concept_a": { "type": "string" },
    "concept_b": { "type": "string" },
    "human_concept_validity_a": {
      "type": "integer",
      "enum": [0, 1]
    },
    "human_concept_validity_b": {
      "type": "integer",
      "enum": [0, 1]
    },
    "human_relation_type": {
      "type": "string",
      "enum": [
        "REQUIRES",
        "UNLOCKS",
        "PART_OF",
        "USES",
        "CONTRASTS_WITH",
        "RELATED",
        "UNRELATED"
      ]
    },
    "human_prereq_direction": {
      "type": "string",
      "enum": ["A_BEFORE_B", "B_BEFORE_A", "UNDIRECTED", "NONE"]
    },
    "human_evidence_support_0_1_2": {
      "type": "integer",
      "enum": [0, 1, 2]
    },
    "human_source_verified_0_1": {
      "type": "integer",
      "enum": [0, 1]
    },
    "human_confidence_high_med_low": {
      "type": "string",
      "enum": ["High", "Medium", "Low"]
    },
    "human_uncertainty_flag": {
      "type": "integer",
      "enum": [0, 1]
    },
    "human_notes": { "type": "string" }
  }
}
