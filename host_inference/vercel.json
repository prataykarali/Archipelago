{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app.py": {
      "maxDuration": 300,
      "excludeFiles": "{.env,.env.*,**/.env,**/.env.*,**/__pycache__/**,**/*.pyc}"
    }
  },
  "crons": [
    {"path": "/api/research/intake/scheduled", "schedule": "0 3 * * *"},
    {"path": "/api/internal/s5-monitor-tick", "schedule": "0 4 * * *"}
  ]
}
