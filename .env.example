# Archipelago AI — Environment Variables
# Copy this file to .env and fill in your values for local development.
# On Northflank / Docker: inject these as platform environment variables.
# Never commit your real .env to version control.

# ── Ollama SLM (GPU) ─────────────────────────────────────────────────────────
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_KEEP_ALIVE=-1
ARCHIPELAGO_OLLAMA_MODEL=qwen3.5:0.8b

# ── Server Ports ───────────────────────────────────────────────────────────────
ARCHIPELAGO_INFERENCE_PORT=5051
ARCHIPELAGO_GRAPH_PORT=5050
ARCHIPELAGO_CHAT_PORT=5052

# ── Security ───────────────────────────────────────────────────────────────────
# Set this to expose services on 0.0.0.0 (e.g. behind a reverse proxy)
# Leave empty to bind to 127.0.0.1 only (default, safe for local dev)
ARCHIPELAGO_TOKEN=

# ── Embedding model (optional, larger model) ───────────────────────────────────
# Set to 1 to load Snowflake Arctic sentence-transformer embeddings
ARCHIPELAGO_LOAD_EMBEDDINGS=0
ARCHIPELAGO_EMBED_DEVICE=cpu
ARCHIPELAGO_FORCE_CPU_EMBED=

# ── E-resource credentials (optional) ─────────────────────────────────────────
# Path to a JSON file containing institutional database credentials
ARCHIPELAGO_ERESOURCE_JSON=

# ── Library membership card counts ────────────────────────────────────────────
ARCHIPELAGO_MEMBERSHIP_BRITISH_COUNCIL=0
ARCHIPELAGO_MEMBERSHIP_AMERICAN_LIBRARY=0

# ── Rate limiting ──────────────────────────────────────────────────────────────
ARCHIPELAGO_RATE_LIMIT_PER_MIN=20
ARCHIPELAGO_RATE_LIMIT_BURST=50
ARCHIPELAGO_RATE_LIMIT_GLOBAL=500
# Set to 1 to disable rate limiting entirely (dev only)
ARCHIPELAGO_RATE_LIMIT_DISABLED=

# ── Retrieval thresholds (optional tuning) ─────────────────────────────────────
ARCHIPELAGO_RETRIEVAL_THRESHOLD=0.75
ARCHIPELAGO_REJECT_THRESHOLD=0.40
ARCHIPELAGO_SEMANTIC_THRESHOLD=0.52
ARCHIPELAGO_LEXICAL_THRESHOLD=80
ARCHIPELAGO_DOMAIN_SOFT_THRESHOLD=0.28
ARCHIPELAGO_KILL_SWITCH=0.75
ARCHIPELAGO_TOP_K_RELATED=5

# ── PDF base URL ───────────────────────────────────────────────────────────────
ARCHIPELAGO_PDF_BASE_URL=http://localhost:5051
