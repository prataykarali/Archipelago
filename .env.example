# Archipelago AI — Environment Variables
# Copy this file to .env and fill in your values for local development.
# On Northflank / Docker: inject these as platform environment variables.
# Never commit your real .env to version control.

# ── Supabase authentication (required for a deployed login) ───────────────────
# Set ARCHIPELAGO_ENV=production on deployed services. Auth is mandatory there.
ARCHIPELAGO_ENV=development
# Browser-safe project values only. Do not put SUPABASE_SECRET_KEY here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
ARCHIPELAGO_CHAT_URL=http://127.0.0.1:5152
ARCHIPELAGO_GRAPH_URL=http://127.0.0.1:5150
# Set a parent domain (for example .example.edu) only when chat and graph use
# sibling subdomains and must share the Supabase session cookie.
ARCHIPELAGO_COOKIE_DOMAIN=
ARCHIPELAGO_COOKIE_SECURE=
# Server-only: needed exclusively by scripts/supabase_provision_users.py and
# the future credential-import worker. Store it in the host's secret manager.
SUPABASE_SECRET_KEY=
# Legacy Supabase projects may use SUPABASE_SERVICE_ROLE_KEY instead.
# Required for every shared/deployed environment. Set to 0 only for an
# isolated local test process, never on Render/Railway.
ARCHIPELAGO_AUTH_REQUIRED=1
# Dev role headers are disabled by default. Enable only for isolated tests.
ARCHIPELAGO_ALLOW_DEV_AUTH=0
# Never enable open write endpoints on a deployed service.
ARCHIPELAGO_ALLOW_OPEN_MUTATIONS=0

# ── Ollama SLM (GPU) ─────────────────────────────────────────────────────────
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_KEEP_ALIVE=-1
ARCHIPELAGO_OLLAMA_MODEL=qwen3.5:0.8b

# ── Inference LLM APIs ────────────────────────────────────────────────────────
# Active provider: 'xkiro' (default), 'gemini', or 'ollama' (fallback)
ARCHIPELAGO_LLM_PROVIDER=xkiro

# xkiro API (OpenAI-compatible)
XKIRO_BASE_URL=https://api.xkiro.com/v1
XKIRO_API_KEY=
XKIRO_MODEL=qwen/qwen3.8-max:free

# Google Gemini API (AI Studio)
GEMINI_API_KEY=
ARCHIPELAGO_GEMINI_MODEL=gemini-2.0-flash

# ── Server Ports ───────────────────────────────────────────────────────────────
ARCHIPELAGO_INFERENCE_PORT=5051
ARCHIPELAGO_GRAPH_PORT=5050
ARCHIPELAGO_CHAT_PORT=5052

# ── Security ───────────────────────────────────────────────────────────────────
# Librarian token: REQUIRED on shared machines to protect upload / delete /
# manual-node endpoints. Students stay on the open chat. Leave EMPTY only for
# local dev (tests + single-user computer).
ARCHIPELAGO_LIBRARIAN_TOKEN=

# Optional legacy shared-token (accepted if ARCHIPELAGO_LIBRARIAN_TOKEN unset).
# Prefer ARCHIPELAGO_LIBRARIAN_TOKEN in new deployments.
ARCHIPELAGO_TOKEN=

# Containers bind to 0.0.0.0; local processes may use 127.0.0.1.
ARCHIPELAGO_BIND=127.0.0.1
ARCHIPELAGO_INFERENCE_URL=http://127.0.0.1:5151

# ── Embedding model (optional, larger model) ───────────────────────────────────
# Set to 1 to load Snowflake Arctic sentence-transformer embeddings
ARCHIPELAGO_LOAD_EMBEDDINGS=0
ARCHIPELAGO_EMBED_DEVICE=cpu
ARCHIPELAGO_FORCE_CPU_EMBED=

# ── E-resource credentials (optional) ─────────────────────────────────────────
# Path to a JSON file containing institutional database credentials
ARCHIPELAGO_ERESOURCE_JSON=

# ── Library membership card counts ────────────────────────────────────────────
ARCHIPELAGO_MEMBERSHIP_BRITISH_COUNCIL=0
ARCHIPELAGO_MEMBERSHIP_AMERICAN_LIBRARY=0

# ── Rate limiting ──────────────────────────────────────────────────────────────
ARCHIPELAGO_RATE_LIMIT_PER_MIN=20
ARCHIPELAGO_RATE_LIMIT_BURST=50
ARCHIPELAGO_RATE_LIMIT_GLOBAL=500
# Set to 1 to disable rate limiting entirely (dev only)
ARCHIPELAGO_RATE_LIMIT_DISABLED=

# ── Retrieval thresholds (optional tuning) ─────────────────────────────────────
ARCHIPELAGO_RETRIEVAL_THRESHOLD=0.75
ARCHIPELAGO_REJECT_THRESHOLD=0.40
ARCHIPELAGO_SEMANTIC_THRESHOLD=0.52
ARCHIPELAGO_LEXICAL_THRESHOLD=80
ARCHIPELAGO_DOMAIN_SOFT_THRESHOLD=0.28
ARCHIPELAGO_KILL_SWITCH=0.75
ARCHIPELAGO_TOP_K_RELATED=5

# ── Web fetch compliance gate ────────────────────────────────────────────────
# Every outbound fetch passes archipelago/ingestion/fetch_policy.py first.
# Default is DENY-ALL: with this unset no host may be fetched.
# Comma-separated hosts or suffixes, e.g. arxiv.org,openaccess.org.
# See docs/guides/WEB_FETCH_POLICY.md before adding anything here.
ARCHIPELAGO_FETCH_ALLOWLIST=
# Append-only JSONL record of every allowed/refused fetch. Recommended on.
ARCHIPELAGO_FETCH_AUDIT_LOG=
# Identify honestly per robots.txt convention.
ARCHIPELAGO_FETCH_USER_AGENT=ArchipelagoLibraryBot/1.0 (+institutional graph)

# Root for institutional state that travels with the corpus rather than the
# code: the source-lifecycle ledger and the librarian ingest-proposal queue.
# Point this at the library appliance's data volume in production.
ARCHIPELAGO_STATE_DIR=

# ── Apify (web-data Actors for source discovery) ──────────────────────────────
# Server-side only: never expose this token to the browser. Runs are metered;
# the client refuses to start a paid Actor unless an explicit USD cap is set.
APIFY_TOKEN=
# Hard ceiling for any single Actor run, in USD. Keep it small.
APIFY_MAX_TOTAL_CHARGE_USD=1.00

# ── Public origin / PDF base URL ────────────────────────────────────────────────
# Leave blank to use same-origin /pdfs routes. Set this only when the PDF API is
# deployed as a separate public service.
ARCHIPELAGO_PDF_BASE_URL=
ARCHIPELAGO_PUBLIC_ORIGIN=

# Optional legacy JWT verification secret. Supabase Bearer verification remains
# the source of truth when SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY are set.
SUPABASE_JWT_SECRET=
PEARSON_SUBSCRIPTION_ID=

# ── Pearson eLibrary (institutional account) ──────────────────────────────
# Reader links are built from the per-book subscription id in
# data/catalogs/pearson_bookshelf.json. These are only needed for the optional
# kiosk hint panel, and MUST come from the environment: never commit them.
PEARSON_PORTAL_URL=https://elibrary.in.pearson.com/
PEARSON_ACCOUNT_USERNAME=
PEARSON_ACCOUNT_PASSWORD=
# Render the credential hint on the external reader gateway (kiosk demos only).
# Leave "0" in production: any unauthenticated fetch would then read the secret.
ARCHIPELAGO_EXPOSE_READER_CREDENTIALS=0
