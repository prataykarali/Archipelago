# Library Computer Environment Configuration
# Copy to .env and fill in actual values.

# ─── Supabase ────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-server-secret-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ─── Public inference API (Vercel target) ──────
# Set only after the Vercel preview passes the production plan gates.
ARCHIPELAGO_INFERENCE_URL=https://your-vercel-project.vercel.app
# Compose overrides this for the graph server with its internal ingestion API.
# Leave unset on cloud services and any process without a local receiver.
ARCHIPELAGO_LOCAL_INGEST_URL=

# ─── Local Model ─────────────────────────────────
OKF_LOCAL_MODEL=/app/models/lib-qwen
ARCHIPELAGO_OLLAMA_HOST=http://ollama:11434

# ─── Hugging Face ────────────────────────────────
HF_TOKEN=your-hf-token
HF_MODEL_REPO=Prataykarali/lib-qwen
HF_MODEL_REVISION=v5

# ─── Graph ───────────────────────────────────────
ARCHIPELAGO_GRAPH_JSON=/app/graph-state/okf_graph.json

# ─── Environment ─────────────────────────────────
ARCHIPELAGO_ENV=library
ARCHIPELAGO_AUTH_REQUIRED=1
# Browser origin for the staff graph UI. Set to the approved Cloudflare hostname
# only after the public Vercel release passes the production plan gates.
ARCHIPELAGO_PUBLIC_ORIGIN=http://127.0.0.1:5150
