# Library Computer Environment Configuration
# Copy to .env and fill in actual values.

# ─── Supabase ────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ─── Inference API (AntDeploy) ───────────────────
ARCHIPELAGO_INFERENCE_URL=https://archipelago.antideploy.com

# ─── Local Model ─────────────────────────────────
OKF_LOCAL_MODEL=/app/models/lib-qwen
OLLAMA_HOST=http://host.docker.internal:11434

# ─── Hugging Face ────────────────────────────────
HF_TOKEN=your-hf-token
HF_MODEL_REPO=Prataykarali/lib-qwen
HF_MODEL_REVISION=v5

# ─── Graph ───────────────────────────────────────
ARCHIPELAGO_GRAPH_JSON=/app/graph-state/okf_graph.json

# ─── Environment ─────────────────────────────────
ARCHIPELAGO_ENV=library
ARCHIPELAGO_AUTH_REQUIRED=1
