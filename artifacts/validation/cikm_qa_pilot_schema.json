{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Archipelago CIKM 2027 Research QA Benchmark Record",
  "type": "object",
  "required": [
    "query_id",
    "source_doc_ids",
    "question",
    "question_category",
    "gold_supporting_passages",
    "exact_page_refs",
    "relevant_passage_labels",
    "expected_prerequisite_paths",
    "answerability_status",
    "annotator_id",
    "annotation_confidence",
    "disagreement_notes",
    "review_status"
  ],
  "properties": {
    "query_id": { "type": "string", "pattern": "^CIKM-[A-Z0-9-]+$" },
    "source_doc_ids": { "type": "array", "items": { "type": "string" } },
    "question": { "type": "string", "minLength": 10 },
    "question_category": {
      "type": "string",
      "enum": [
        "single_hop_definition",
        "multi_hop_prerequisite",
        "cross_paper_comparison",
        "provenance_citation_check",
        "unanswerable_out_of_corpus"
      ]
    },
    "gold_supporting_passages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["doc_id", "chunk_id", "page_number", "quote_span"],
        "properties": {
          "doc_id": { "type": "string" },
          "chunk_id": { "type": "string" },
          "page_number": { "type": "integer", "minimum": 1 },
          "quote_span": { "type": "string" }
        }
      }
    },
    "exact_page_refs": { "type": "array", "items": { "type": "string" } },
    "relevant_passage_labels": {
      "type": "object",
      "additionalProperties": { "type": "integer", "enum": [0, 1, 2] }
    },
    "expected_prerequisite_paths": {
      "type": "array",
      "items": { "type": "array", "items": { "type": "string" } }
    },
    "answerability_status": {
      "type": "string",
      "enum": [
        "ANSWERABLE",
        "PARTIALLY_ANSWERABLE",
        "UNANSWERABLE_OUT_OF_CORPUS",
        "PENDING_ANNOTATION"
      ]
    },
    "annotator_id": { "type": ["string", "null"] },
    "annotation_confidence": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0 },
    "disagreement_notes": { "type": ["string", "null"] },
    "review_status": {
      "type": "string",
      "enum": [
        "UNVERIFIED_CANDIDATE",
        "SINGLE_ANNOTATED",
        "DOUBLE_ANNOTATED_DISAGREEMENT",
        "ADJUDICATED_GOLD"
      ]
    }
  }
}
