{
  "applicationId": "9ad633c9-b651-45ec-af34-9eafa02d13dc",
  "name": "archipelago",
  "build_command": "pip install -r requirements.txt",
  "start_command": "sh -c 'PYTHONPATH=$PWD gunicorn --chdir host_inference --bind 0.0.0.0:5151 hostapp.wsgi'",
  "health_check": "/api/readiness",
  "env": {
    "FLASK_ENV": "production",
    "HF_ENDPOINT": "https://huggingface.co",
    "HF_DATASET_REPO": "Pratay/archipelago-corpus"
  },
  "port": 5151
}
